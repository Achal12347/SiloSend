<?xml version="1.0" encoding="utf-8"?>
<!-- Splash before Android 12: app background with the app icon centred.
     The icon comes from the launcher icon, so replacing the icon updates it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/vayu_window_background" />
    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>
